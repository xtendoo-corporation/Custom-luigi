<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_commission" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.commission.first.sale</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_view_first_sale_commissions"
                    icon="fa-handshake-o">
                    <field string="Comisiones" name="commission_first_sale_count" widget="statinfo" />
                </button>
            </div>
        </field>
    </record>
</odoo>