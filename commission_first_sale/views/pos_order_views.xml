<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar vista form de pos.order para añadir campo agent_id en líneas -->
    <record id="view_pos_order_form_inherit_commission" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.commission.first.sale</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <!-- Añadir columna de agente en las líneas de pedido POS -->
            <xpath expr="//field[@name='lines']/list//field[@name='qty']" position="after">
                <field name="is_commission_locked" column_invisible="True" />
                <field name="agent_id" string="Agente" optional="show"
                    readonly="is_commission_locked"
                    force_save="1"
                    options="{'no_create': True}" />
            </xpath>
        </field>
    </record>

    <!-- Heredar vista tree de pos.order.line si existe -->
    <record id="view_pos_order_line_form_inherit_commission" model="ir.ui.view">
        <field name="name">pos.order.line.form.inherit.commission.first.sale</field>
        <field name="model">pos.order.line</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_line" />
        <field name="arch" type="xml">
            <!-- Añadir campo agente en la vista de líneas -->
            <xpath expr="//field[@name='qty']" position="after">
                <field name="agent_id" string="Agente" optional="show" />
            </xpath>
        </field>
    </record>

</odoo>